# Infrastructure only. Every service key (Claude, OpenAI, Gemini, Higgsfield, ElevenLabs, Instagram/Meta,
# TikTok, YouTube, Telegram) is saved in the app's Integrations page, encrypted in the database.

# Optional local admin login. Values must be supplied through protected project secrets, never committed.
APP_ADMIN_IDENTIFIER=
APP_ADMIN_PASSWORD=

# Encrypts every key saved in the Integrations page. Set once, back it up, never change it.
INTEGRATION_ENCRYPTION_KEY=

# Supabase — database, auth and storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres
# Used only when the direct Supabase host is IPv6-only; detected default is eu-west-1.
SUPABASE_DB_POOLER_REGION=eu-west-1
SUPABASE_DB_POOLER_CLUSTER=aws-0
SUPABASE_DB_POOLER_PORT=5432
SUPABASE_STORAGE_BUCKET=reelsfab

# Access control — admins are matched on VERIFIED Supabase e-mails (comma separated).
ADMIN_EMAILS=you@example.com
# Local development only: first sign-in becomes admin when no admin exists.
ALLOW_FIRST_USER_ADMIN=false

# Scheduler callbacks (pg_cron / any external cron): send "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -hex 32  (min 24 chars)
CRON_SECRET=

# Session signing for the local admin login (any long random string).
SESSION_SECRET=
APP_ID=reelsfab

# Studio autopilot (daily script batch -> ffmpeg render -> schedule -> publish). Run on exactly one container.
AUTOPILOT_ENABLED=false
# kokoro (free local voice, default) | test (tone, CI only)
TTS_PROVIDER=kokoro

# Appended to every published caption (AI + ad disclosure). Set empty to disable.
DISCLOSURE_TAGS="#AIgenerated #ad"
