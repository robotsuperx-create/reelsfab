# Meta / Instagram OAuth secrets — configure after creating a Meta app
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-domain.example.com/api/meta/callback
META_TOKEN_ENCRYPTION_KEY=generate-a-long-random-secret
